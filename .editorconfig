root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,html,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

# ---------------------------------------------------------------------------
# C# analyzer configuration
#
# The solution builds with TreatWarningsAsErrors, so every rule left at warning
# level is a build gate. The Excel "Lint / Rule Violations" family reads this
# configuration plus the resulting build output as its evidence.
# ---------------------------------------------------------------------------
#
# CA2007 (ConfigureAwait) is intentionally left disabled: ASP.NET Core has no
# synchronisation context, so ConfigureAwait(false) adds noise without changing
# behaviour. Microsoft's own guidance excludes it for ASP.NET Core projects.
[*.cs]
dotnet_diagnostic.CA1062.severity = warning
dotnet_diagnostic.CA1707.severity = warning

# ---------------------------------------------------------------------------
# Entity Framework Core generates the files under Data/Migrations. They are
# machine-written and are regenerated by `dotnet ef migrations add`, so
# hand-written style and performance preferences are not meaningful there and
# editing them would be overwritten. Only the rules that generated migration
# code legitimately trips are relaxed; correctness rules stay enabled.
#
# The Excel "Accuracy Tuning / False Positive Rate" metric expects a suppression
# rate below 10%; this scope covers generated files only.
# ---------------------------------------------------------------------------
[**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none

# Test projects legitimately use underscored method names to describe scenarios, and xUnit theory
# methods are public only so the runner can discover them — no external caller can pass null, so
# defensive argument checks would be dead code.
[**/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
