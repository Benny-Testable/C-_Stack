{
  "name": "scholarship-cmgroups",
  "private": true,
  "version": "1.0.0",
  "description": "Scholarship CMGroups React client (negative metric validation baseline)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "mocha",
    "coverage": "nyc mocha --node-option loader=@istanbuljs/esm-loader-hook",
    "coverage:report": "nyc --check-coverage=false mocha --node-option loader=@istanbuljs/esm-loader-hook",
    "lint": "eslint --ext .js,.jsx --max-warnings 0 src",
    "lint:report": "eslint --ext .js,.jsx -f json -o reports/eslint.json src"
  },
  "dependencies": {
    "axios": "1.7.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1"
  },
  "devDependencies": {
    "@istanbuljs/esm-loader-hook": "0.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.47.0",
    "mocha": "10.8.2",
    "nyc": "17.1.0",
    "vite": "6.0.7"
  }
}
