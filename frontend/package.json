{
  "name": "scholarship-cmgroups-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "React client for Scholarship CMGroups (Webpack + Yarn build variant).",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
