# Copy to .env.local and adjust. .env.local is git-ignored.
#
# IMPORTANT: every VITE_-prefixed variable is inlined into the JavaScript bundle and is therefore
# readable by anyone who loads the page. Only public configuration belongs here. Connection strings,
# JWT signing keys, and the bootstrap administrator password are backend settings and are supplied
# through dotnet user-secrets or environment variables instead — see docs/setup.md.

# Origin of the API. Leave empty to call the same origin as the page, which is what the Vite dev
# server proxy and a production reverse proxy both expect.
VITE_API_BASE_URL=
