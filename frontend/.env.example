# Copy to .env and adjust. Do not commit .env.
#
# Webpack reads API_BASE_URL at build/start time through DefinePlugin. It is inlined into the
# JavaScript bundle and is therefore public. Connection strings, JWT signing keys, and the
# bootstrap administrator password are backend settings — see docs/setup.md.

# Origin of the API. Leave empty to call the same origin as the page (Webpack dev-server proxy).
API_BASE_URL=
