@model IEnumerable<Application>
<section class="panel">
    <h1>Applications</h1>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Student</th>
                <th>Scholarship</th>
                <th>Status</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ApplicationId</td>
                <td>@item.StudentId</td>
                <td>@item.ScholarshipId</td>
                <td>@item.ApplicationStatusId</td>
                <td>@item.RequestedAmount</td>
            </tr>
        }
        </tbody>
    </table>
</section>
