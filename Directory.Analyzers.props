<Project>
  <!--
    Scholarship CMGroups — Roslyn static analysis (Whitebox_Tools_Registry, C# rows 1-2):
      roslyn-analyzers : Microsoft.CodeAnalysis.NetAnalyzers 8.0.0
      sonar-cs         : SonarAnalyzer.CSharp 9.32.0.97167
    Findings are emitted as build WARNINGS so `dotnet build` passes, and written to SARIF.
    The lint gate (`-p:LintGate=true`) promotes warnings to errors, which FAILS on this
    negative baseline branch by design. Rule severities live in .editorconfig.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ErrorLog>$(MSBuildThisFileDirectory)reports/lint/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.32.0.97167">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
